; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

curved_lines_2d/close_pencil_path=false
curved_lines_2d/add_stroke_enabled=true
curved_lines_2d/line_begin_cap=0
curved_lines_2d/line_end_cap=0
curved_lines_2d/line_joint_mode=0

[application]

config/name="Sree Birthday Game 2026"
run/main_scene="uid://blpu3g8fiolkk"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameState="*res://scripts/globals/game_state.gd"
Ui="*res://scenes/ui/ui.tscn"
EventManager="*res://scripts/event_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/aspect="keep_height"
mouse_cursor/custom_image="uid://u8omv3qwstn1"
mouse_cursor/custom_image_hotspot=Vector2(11, 6)

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://componenets/": "orange",
"res://dialogue/": "red",
"res://scenes/": "blue",
"res://scripts/": "teal",
"res://scripts/globals/": "green",
"res://tileset/": "yellow"
}

[gui]

theme/default_font_multichannel_signed_distance_field=true

